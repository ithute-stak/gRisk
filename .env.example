# gRisk environment template
# Copy to .env for local use. Do not commit real secrets.

GRISK_ENVIRONMENT=development
GRISK_API_HOST=0.0.0.0
GRISK_API_PORT=8000

# Use a cryptographically random value of at least 32 characters in production.
GRISK_SECRET_KEY=replace-with-a-long-random-secret
GRISK_JWT_ALGORITHM=HS256
GRISK_ACCESS_TOKEN_EXPIRE_MINUTES=60
GRISK_JWT_ISSUER=grisk-api
GRISK_JWT_AUDIENCE=grisk-web

GRISK_LOGIN_RATE_LIMIT_ATTEMPTS=10
GRISK_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

GRISK_DATABASE_URL=postgresql+asyncpg://grisk:grisk@postgres:5432/grisk
GRISK_REDIS_URL=redis://redis:6379/0
GRISK_CORS_ORIGINS=http://localhost:8080

# Durable document storage. Docker Compose mounts a persistent volume at /data/documents.
GRISK_DOCUMENT_STORAGE_PATH=/data/documents
GRISK_DOCUMENT_MAX_UPLOAD_MB=20

# Optional one-time values consumed by `python -m app.scripts.bootstrap_admin`.
# Leave blank during normal application runtime.
GRISK_BOOTSTRAP_ADMIN_EMAIL=
GRISK_BOOTSTRAP_ADMIN_PASSWORD=
GRISK_BOOTSTRAP_ADMIN_NAME=gRisk Administrator

POSTGRES_DB=grisk
POSTGRES_USER=grisk
POSTGRES_PASSWORD=grisk

# Next.js server-to-server API URL and public web port.
WEB_API_BASE_URL=http://api:8000
GRISK_WEB_PORT=8080
