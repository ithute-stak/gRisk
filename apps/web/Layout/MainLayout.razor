@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">gR</div>
            <div>
                <strong>gRisk</strong>
                <span>Guardrisk 360</span>
            </div>
        </div>

        <nav class="nav-list" aria-label="Primary navigation">
            <NavLink href="" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="customers">Customers</NavLink>
            <NavLink href="quotations">Quotations</NavLink>
            <NavLink href="policies">Policies</NavLink>
            <NavLink href="claims">Claims</NavLink>
            <NavLink href="medical-aid">Medical Aid</NavLink>
            <NavLink href="bonds">Bonds & Guarantees</NavLink>
            <NavLink href="risk">Risk Management</NavLink>
            <NavLink href="finance">Finance</NavLink>
            <NavLink href="reports">Reports</NavLink>
            <NavLink href="administration">Administration</NavLink>
        </nav>

        <div class="sidebar-footer">
            <span>@(Auth.CurrentUser?.Name ?? Auth.CurrentUser?.Email ?? "Guardrisk user")</span>
            <button class="text-button" @onclick="SignOutAsync">Sign out</button>
        </div>
    </aside>

    <main class="main-panel">
        <header class="topbar">
            <div>
                <span class="topbar-label">Guardrisk operating platform</span>
            </div>
            <div class="environment-pill">Development</div>
        </header>
        <div class="content-area">
            @Body
        </div>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Auth.SessionChanged += OnSessionChanged;
        await Auth.InitializeAsync();
        if (!Auth.IsAuthenticated)
        {
            Navigation.NavigateTo("login");
        }
    }

    private async Task SignOutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login");
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Auth.SessionChanged -= OnSessionChanged;
    }
}
