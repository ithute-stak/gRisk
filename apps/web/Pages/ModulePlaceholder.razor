@page "/customers"
@page "/quotations"
@page "/policies"
@page "/claims"
@page "/medical-aid"
@page "/bonds"
@page "/risk"
@page "/finance"
@page "/reports"
@page "/administration"
@inject NavigationManager Navigation

<PageTitle>@Title | gRisk</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">gRisk module</p>
        <h1>@Title</h1>
        <p class="lede">This module is registered in the application shell and will be implemented in its delivery phase.</p>
    </div>
</section>

<section class="module-card">
    <div class="module-index">→</div>
    <div>
        <h2>Foundation ready</h2>
        <p>The Blazor route is active and ready to connect to the FastAPI domain endpoints, PostgreSQL data model, Redis services and realtime events.</p>
    </div>
</section>

@code {
    private string Title => Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant() switch
    {
        "customers" => "Customers",
        "quotations" => "Quotations",
        "policies" => "Policies",
        "claims" => "Claims",
        "medical-aid" => "Medical Aid",
        "bonds" => "Bonds & Guarantees",
        "risk" => "Risk Management",
        "finance" => "Finance",
        "reports" => "Reports",
        "administration" => "Administration",
        _ => "Module"
    };
}
