# gRisk production environment template
# Copy to .env.production outside source control and replace every CHANGE_ME value.
# The API intentionally refuses to start with a weak GRISK_SECRET_KEY.

POSTGRES_DB=grisk
POSTGRES_USER=grisk_app
POSTGRES_PASSWORD=CHANGE_ME
GRISK_DATABASE_URL=postgresql+asyncpg://grisk_app:CHANGE_ME@postgres:5432/grisk
GRISK_REDIS_URL=redis://redis:6379/0

GRISK_SECRET_KEY=CHANGE_ME
GRISK_JWT_ALGORITHM=HS256
GRISK_ACCESS_TOKEN_EXPIRE_MINUTES=60
GRISK_JWT_ISSUER=grisk-api
GRISK_JWT_AUDIENCE=grisk-web

GRISK_CORS_ORIGINS=https://grisk.example.com
GRISK_LOGIN_RATE_LIMIT_ATTEMPTS=10
GRISK_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
GRISK_DOCUMENT_MAX_UPLOAD_MB=20

# Host-loopback ports consumed by the HTTPS reverse proxy.
GRISK_WEB_PORT=8080
GRISK_API_PORT=8000

# The production Compose file forces this to true for Next.js.
GRISK_COOKIE_SECURE=true
